FROM nginx:alpine

# openssl is needed to generate the transient self-signed placeholder certificate in
# frontend-entrypoint.sh (see that script for why it's needed at all).
RUN apk add --no-cache openssl

# index.html at the root (served at /)
COPY app/api/static/index.html /usr/share/nginx/html/index.html

# JS, CSS, and other assets served at /static/
COPY app/api/static/ /usr/share/nginx/html/static/

# nginx site config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Replaces nginx:alpine's own entrypoint entirely (not placed under
# /etc/nginx/templates/ — that path triggers the base image's built-in
# envsubst-on-templates startup script, which would corrupt this config's nginx
# variables like $host/$uri/$http_upgrade by treating them as shell variables).
COPY frontend-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
