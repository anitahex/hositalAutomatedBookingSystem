DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXP_SECONDS=604800

# ---- Hugging Face (all agents, routing, answer composition) ----
# GPT-4o is NEVER called from agents or chat routes — only the ingestion path.
HF_TOKEN=your_hugging_face_token
HF_MODEL=Qwen/Qwen3.6-35B-A3B
HF_ROUTER_MODEL=Qwen/Qwen3.6-35B-A3B
HF_SUMMARY_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_TIMEOUT_SECONDS=30
HF_ROUTER_TIMEOUT_SECONDS=8
HF_SUMMARY_TIMEOUT_SECONDS=12
HF_MAX_TOKENS=512
HF_ROUTER_MAX_TOKENS=180
HF_SUMMARY_MAX_TOKENS=256
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Azure OpenAI — INGESTION PATH ONLY ----
# Used exclusively by app/inference/azure_client.py for:
#   1. Guardrail 1: medical relevance check (gpt4o_relevance_check)
#   2. Tier 2: structured extraction (gpt4o_structured_extraction)
# Do NOT import azure_client from agents or chat routes.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ---- Azure Blob Storage — raw vault + summary JSON ----
# Blob layout:
#   staging/{user_id}/{document_id}/{filename}   — pre-consent
#   vault/{user_id}/{session_id}/{document_id}/{filename}  — confirmed
#   summaries/{user_id}/{document_id}.json       — extracted summary
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=hospital-documents

# ---- Qdrant (existing global clinical-reference RAG only) ----
# Used ONLY by app/services/rag.py and app/services/vector_store.py
# for department/doctor matching. NOT used for user-uploaded document content.
# Local embedded Qdrant, no Docker/server required:
QDRANT_MODE=local
QDRANT_LOCAL_PATH=qdrant_storage
# Remote Qdrant Cloud alternative:
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=clinical_knowledge_base
VECTOR_SIZE=384
