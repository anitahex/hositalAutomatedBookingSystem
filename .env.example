DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_db
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_MAX_CONNECTIONS=10
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXP_SECONDS=604800
# Only set during a deliberate secret rotation: the PREVIOUS JWT_SECRET value, so
# tokens issued before the rotation keep verifying until they expire. Leave unset
# otherwise — do not use this as a permanent fallback.
JWT_LEGACY_SECRET=

# Interactive API docs (/docs, /redoc, /openapi.json) expose the full schema,
# including admin models. Disabled unless set to true — enable for local dev only.
ENABLE_API_DOCS=false

# ---- Postgres (Docker Compose only) ----
# Used by docker-compose.yml to set the postgres container's password and build
# DATABASE_URL for the backend service — set this to a real value, not the default.
POSTGRES_PASSWORD=replace_with_a_strong_db_password

# ---- Hugging Face embeddings (REQUIRED — the backend fails to start without this) ----
# Used for department/doctor RAG matching via a remote HF Inference Endpoint call.
# Unlike OPENAI_API_KEY (which degrades gracefully if unset), a missing HF_TOKEN
# raises at module import time and crashes the whole backend container on boot.
HF_TOKEN=your-huggingface-token
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Optional admin bootstrap ----
# Set true only when you intentionally want startup to create/update this account.
# Keep real values in your untracked .env or deployment secret store.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Administrator

# ---- Doctor authentication ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCTOR_AUTH_ENCRYPTION_KEY=
DOCTOR_AUTH_FRONTEND_URL=http://localhost:8010
# Only set true in explicitly approved development/test environments. No raw tokens are logged.
DOCTOR_AUTH_EMAIL_NO_SEND=false
DOCTOR_AUTH_SMTP_HOST=
DOCTOR_AUTH_SMTP_PORT=587
DOCTOR_AUTH_SMTP_USE_TLS=true
DOCTOR_AUTH_SMTP_USERNAME=
DOCTOR_AUTH_SMTP_PASSWORD=
DOCTOR_AUTH_EMAIL_FROM=
DOCTOR_AUTH_LOGIN_RATE_LIMIT=10
DOCTOR_AUTH_MFA_RATE_LIMIT=10

# ---- OpenAI-compatible conversation model (all agent calls) ----
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
LANGUAGE_ID_PROVIDER=fasttext
LANGUAGE_ID_MODEL_PATH=models/lid.176.bin
LANGUAGE_ID_MIN_CONFIDENCE=0.55

# ---- Azure OpenAI — conversation / routing / summary (all agent calls) ----
# Model: azureml://registries/azure-openai/models/gpt-5.4-mini/versions/2024-07-18
# AZURE_ROUTER_DEPLOYMENT and AZURE_SUMMARY_DEPLOYMENT default to AZURE_CONV_DEPLOYMENT if omitted.

# ---- Azure OpenAI — INGESTION PATH ONLY ----
# Used exclusively by app/inference/azure_client.py for:
#   1. Guardrail 1: medical relevance check (gpt4o_relevance_check)
#   2. Tier 2: structured extraction (gpt4o_structured_extraction)

# ---- Azure Blob Storage — raw vault + summary JSON ----
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=hospital-documents

# ---- Qdrant (department / doctor RAG matching) ----
QDRANT_MODE=local
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=clinical_knowledge_base
VECTOR_SIZE=384
DEEPGRAM_API_KEY=your_key_here

# ---- Twilio WhatsApp webhook ----
# Configure the Twilio WhatsApp sender's incoming message URL as:
# https://your-public-host/webhooks/whatsapp
TWILIO_AUTH_TOKEN=your-twilio-auth-token
VALIDATE_TWILIO_WEBHOOK=true
PUBLIC_BASE_URL=https://your-public-host

# ---- HTTPS (Caddy, see Caddyfile — automatic Let's Encrypt issuance and renewal) ----
# An inbox you actually monitor — Let's Encrypt sends renewal-failure notices here.
LETSENCRYPT_EMAIL=you@example.com
