.env
.env.local
.env.*.local
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_cache_local/
qdrant_storage/
var/
.claude

# Local runtime data — LangGraph/chat SQLite checkpoints (CHECKPOINT_DB_PATH) and any
# other local-dev runtime state. This is generated at runtime and can contain real
# conversation data; it must never be committed.
data/

# Internal AI-assistant guidance — not part of the shipped application.
Claude Standards/

# Internal security/tech-debt audit reports — not for a public/shared repo, since they
# itemize specific (including still-open) vulnerabilities and known weak points.
FULL_SYSTEM_AUDIT.md
TECH_DEBT.md

# OS / editor cruft
.DS_Store
Thumbs.db

# Test coverage artifacts
.coverage
htmlcov/

# Build-time-downloaded model artifacts (see scripts/download_language_model.py,
# fetched during the Docker build) — not source, and too large to commit anyway.
models/

# Local-only Caddy/Compose overrides for testing HTTPS against localhost — both files'
# own headers say not to deploy or commit them (they swap in a local CA cert instead of
# real ACME, and publish a debug port). See docker-compose.override.yml for details.
docker-compose.override.yml
Caddyfile.local
